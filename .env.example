# Copy to .env.local and fill in. Never commit real values (.env.local is git-ignored).
#
# Use a SEPARATE Supabase project for local development and testing. Pointing a dev machine at the production project
# means a test action is a real action on real data.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by admin features that need to bypass row-level security; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email reminders (optional; the scheduler is paused until these are set) ---
# Public URL of this app, used to build links inside emails.
APP_URL=https://your-app.example.com
# Shared secret that the scheduled call to /api/cron/email must send.
CRON_SECRET=a-long-random-string
EMAIL_FROM="Bobcat Racing <noreply@example.com>"
# Preferred: Resend.
RESEND_API_KEY=
# Fallback: SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
